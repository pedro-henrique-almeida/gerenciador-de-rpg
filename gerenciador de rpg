        self.nome = nome
        self.tipo = nome
        self.vida = vida
        self.vida_maxima = vida
        self.mana = mana
        self.classe = classe
        self.arma = arma
        self.inventario = inventario
        self.atributos = atributos

    def __getitem__(self, chave):
        return getattr(self, chave)


